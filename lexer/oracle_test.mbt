  ("  replace+", true, "id    replace @2-9\nop    + @9-10"),
  (
    "::\"!1+>", true, "ERR '::' is not SQLite syntax (PostgreSQL cast) at offset 0; dialect is SQLite",
  ),
  ("-  insert1", true, "op    - @0-1\nid    insert1 @3-10"),
  ("0x1f&", true, "num   0x1f @0-4\nop    & @4-5"),
  ("replace_y<", true, "id    replace_y @0-9\nop    < @9-10"),
  (
    ")*0x1finsert$$", true, "rparen @0-1\nop    * @1-2\nnum   0x1f @2-6\nid    insert$$ @6-14",
  ),
  ("*e", true, "op    * @0-1\nid    e @1-2"),
  (
    ";aselect.index_y)", true, "semi @0-1\nid    aselect.index_y @1-16\nrparen @16-17",
  ),
  (
    "'x'$$/;", true, "ERR '$$' is not SQLite syntax (PostgreSQL dollar-quote) at offset 3; dialect is SQLite",
  ),
  ("replace", true, "id    replace @0-7"),
  (
    "::\n.select\n", true, "ERR '::' is not SQLite syntax (PostgreSQL cast) at offset 0; dialect is SQLite",
  ),
  ("onindex)--", true, "id    onindex @0-7\nrparen @7-8\ncomm  -- @8-10"),
  (
    "indexE?  @leftleft", true, "id    indexE @0-6\nph    ? @6-7\nph    @leftleft @9-18",
  ),
  ("?11.5@or", true, "ph    ?11 @0-3\nnum   .5 @3-5\nph    @or @5-8"),
  (
    ")>-$$--insertouter(", true, "ERR '$$' is not SQLite syntax (PostgreSQL dollar-quote) at offset 3; dialect is SQLite",
  ),
  ("_y.  ", true, "id    _y @0-2\nop    . @2-3"),
  ("-index)", true, "op    - @0-1\nid    index @1-6\nrparen @6-7"),
  (";from$index(\"?1?", true, "ERR unexpected byte '\"' at offset 12"),
  ("outer@>", true, "ERR unexpected byte '@' at offset 5"),
  ("&", true, "op    & @0-1"),
  ("oninserta-`e1 ", true, "ERR unexpected byte '`' at offset 10"),
  ("\"!insertindex", true, "ERR unexpected byte '\"' at offset 0"),
  ("`e ''x'from$$_y", true, "ERR unexpected byte '`' at offset 0"),
  ("\"=(\né;", false, "ERR unexpected byte '\"' at offset 0"),
  (
    "?11.5.'x'", true, "ph    ?11 @0-3\nnum   .5 @3-5\nop    . @5-6\nquot  'x' @6-9",
  ),
  ("  $", true, "ERR unexpected byte '$' at offset 2"),
  (
    "$$b.c-*&.", true, "ERR '$$' is not SQLite syntax (PostgreSQL dollar-quote) at offset 0; dialect is SQLite",
  ),
  ("select", true, "kw    select @0-6"),
  ("(on", true, "lparen @0-1\nkw    on @1-3"),
  (
    "$$--?1!:-insert", true, "ERR '$$' is not SQLite syntax (PostgreSQL dollar-quote) at offset 0; dialect is SQLite",
  ),
  ("<\n.é", false, "op    <\nop    .\nid    é"),
]

///|
fn dump(source : String, spans~ : Bool) -> String {
  @lexer.lex(source)
  .map(fn(sp) {
    let text = describe(sp.token)
    if spans {
      "\{text} @\{sp.start}-\{sp.end}"
    } else {
      text
    }
  })
  .join("\n") catch {
    e => "ERR \{e}"
  }
}

///|
test "lexer agrees with the OCaml lexer on the oracle corpus" {
  let mismatches = []
  for case in corpus {
    let (source, spans, expected) = case
    let actual = dump(source, spans~)
    if actual != expected {
      mismatches.push(
        "input: \{source.escape()}\nexpected:\n\{expected}\nactual:\n\{actual}",
      )
    }
  }
  assert_eq(mismatches.join("\n---\n"), "")
}
