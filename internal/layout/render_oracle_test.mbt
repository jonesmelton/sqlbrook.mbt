///|
test "render_tokens agrees with the OCaml renderer on the oracle corpus" {
  let mismatches = []
  for case in render_corpus {
    let (source, expected) = case
    let actual = @layout.render_tokens(@lexer.tokenize(source))
    if actual != expected {
      mismatches.push(
        "input: \{source.escape()}\nexpected: \{expected.escape()}\nactual: \{actual.escape()}",
      )
    }
  }
  assert_eq(mismatches.join("\n---\n"), "")
}
